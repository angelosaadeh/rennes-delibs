# Copy this file to `.env` and edit. Real environment variables override it.
# After setting values here you can just run `python app.py` (no env vars on the
# command line).
#
# A line starting with `#` is disabled (just a comment). To activate one of the
# optional settings below, remove the leading `#` and set its value. The lines
# WITHOUT a `#` (LLM_BACKEND, GROQ_API_KEY) are active and meant to be edited.

# Where answers are generated: "local" (offline GGUF) or "groq" (free hosted).
LLM_BACKEND=local

# --- Groq backend only ---
# Free key from https://console.groq.com
GROQ_API_KEY=
# Optional — uncomment to override. Default is llama-3.3-70b-versatile (free on
# Groq, much better than the local 8B).
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Model locations (optional — uncomment to override; defaults: ./models/) ---
# Point these at existing files to avoid re-downloading.
# E5_MODEL_PATH=models/multilingual-e5-base
# LLAMA_MODEL_PATH=models/Meta-Llama-3.1-8B-Instruct-Q6_K.gguf
